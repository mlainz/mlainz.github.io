@article{deLeon2019a,
  title = {Singular {{Lagrangians}} and Precontact {{Hamiltonian}} Systems},
  author = {{de Le{\'o}n}, Manuel and Lainz Valc{\'a}zar, Manuel},
  year = {2019},
  month = aug,
  pages = {1950158},
  issn = {0219-8878},
  doi = {10.1142/S0219887819501585},
  abstract = {In this paper, we discuss the singular Lagrangian systems on the framework of contact geometry. These systems exhibit a dissipative behavior in contrast with the symplectic scenario. We develop a constraint algorithm similar to the presymplectic one studied by Gotay and Nester (the geometrization of the well-known Dirac\textendash Bergmann algorithm). We also construct the Hamiltonian counterpart and prove the equivalence with the Lagrangian side. A Dirac\textendash Jacobi bracket is constructed similar to the Dirac bracket.},
  copyright = {All rights reserved},
  file = {/home/mlainz/Dropbox/Zotero/storage/D7RL3JCE/de León_Lainz Valcázar_2019_Singular Lagrangians and precontact Hamiltonian systems.pdf;/home/mlainz/Dropbox/Zotero/storage/VQ6BQH5T/S0219887819501585.html},
  journal = {Int. J. Geom. Methods Mod. Phys.}
}

