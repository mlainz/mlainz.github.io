}

@article{anahorysimoesContactGeometrySimple2020,
  title = {Contact Geometry for Simple Thermodynamical Systems with Friction},
  author = {Anahory Simoes, Alexandre and {de Le{\'o}n}, Manuel and Lainz, Manuel and {Mart{\'i}n de Diego}, David},
  year = {2020},
  month = {sep},
