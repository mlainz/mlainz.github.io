@article{deleonHigherorderContactMechanics2021,
  title = {Higher-Order Contact Mechanics},
  author = {{de Le{\'o}n}, Manuel and Gaset, Jordi and Lainz, Manuel and {Mu{\~n}oz-Lecanda}, Miguel C. and {Rom{\'a}n-Roy}, Narciso},
